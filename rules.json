{
  "rules": {
    ".read": false,
    ".write": false,
    "matches": {
      ".read": true,
      "$matchId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "homeTeam": { ".validate": "newData.isString() && newData.val().length > 1" },
        "awayTeam": { ".validate": "newData.isString() && newData.val().length > 1" },
        "league": { ".validate": "newData.isString() && newData.val().length > 1" },
        "kickOffTime": { ".validate": "newData.isString()" },
        "prediction": { ".validate": "newData.isString() && newData.val().length > 1" },
        "odds": { ".validate": "newData.isNumber() && newData.val() > 1" },
        "status": { ".validate": "newData.val() === 'pending' || newData.val() === 'won' || newData.val() === 'lost' || newData.val() === 'postponed'" },
        "isPremium": { ".validate": "newData.isBoolean()" },
        "date": { ".validate": "newData.isString()" }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "email": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "isPremium": {
          ".write": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (auth != null && auth.uid === $uid && !data.exists() && newData.val() === false)",
          ".validate": "newData.isBoolean()"
        },
        "subscriptionExpiry": {
          ".write": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (auth != null && auth.uid === $uid && !data.exists() && newData.val() === 0)",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "transactions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$transactionId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['userId', 'amount', 'reference', 'status', 'timestamp'])"
      }
    },
    "admins": {
      ".read": false,
      ".write": false
    }
  }
}
